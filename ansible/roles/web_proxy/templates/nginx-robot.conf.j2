# {{ ansible_managed | default('Managed by Ansible') }}
# Port 80 of the robot: the web UI at / (WebSockets: live data and agent chat). Grafana moved to the server:
# {{ web_proxy_grafana_subpath }}... answers 302 to {{ web_proxy_grafana_redirect }} with the same path and query, so old bookmarks keep working.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 20m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Long-lived WebSockets: the browser stays connected for a whole session.
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;

    location {{ web_proxy_grafana_subpath }} {
        return 302 {{ web_proxy_grafana_redirect }}$request_uri;
    }

    # WebSockets (/ws live data, /ws/agent chat). uvicorn's websockets-sansio send never blocks on a client that stopped
    # reading, so the unit would grow until OOM: nginx drops a client whose socket stays unwritable for 30 s.
    location /ws {
        proxy_pass http://127.0.0.1:{{ web_proxy_web_ui_port }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 30s;
        send_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ web_proxy_web_ui_port }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
    }
}
