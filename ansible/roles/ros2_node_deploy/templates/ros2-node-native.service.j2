[Unit]
Description=ROS2 node {{ node_name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ node_user if (node_user | default('') | length > 0) else ansible_user }}
{% if node_supplementary_groups | default([]) | length > 0 %}
SupplementaryGroups={{ node_supplementary_groups | join(' ') }}
{% endif %}
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
CPUQuota={{ node_cpu_quota | default('50%') }}
MemoryMax={{ node_memory_max | default('256M') }}
{% if node_cpu_weight | default('') | string | length > 0 %}
CPUWeight={{ node_cpu_weight }}
{% endif %}
{% if node_io_weight | default('') | string | length > 0 %}
IOWeight={{ node_io_weight }}
{% endif %}
{% if node_memory_high | default('') | string | length > 0 %}
MemoryHigh={{ node_memory_high }}
{% endif %}
{% if node_oom_score_adjust | default('') | string | length > 0 %}
OOMScoreAdjust={{ node_oom_score_adjust }}
{% endif %}
{% if node_nice | default('') | string | length > 0 %}
Nice={{ node_nice }}
{% endif %}
{% if node_protect_proc | default('') | length > 0 %}
ProtectProc={{ node_protect_proc }}
{% endif %}
{% if node_proc_subset | default('') | length > 0 %}
ProcSubset={{ node_proc_subset }}
{% endif %}
{% if node_no_new_privileges | default(false) | string | lower == 'true' %}
NoNewPrivileges=yes
{% endif %}
{% if node_private_tmp | default(false) | string | lower == 'true' %}
PrivateTmp=yes
{% endif %}
{% for env in ros2_dds_env | default([]) %}
Environment={{ env }}
{% endfor %}
{% for env in node_env | default([]) %}
Environment={{ env }}
{% endfor %}
{% if node_environment_file | default('') | length > 0 %}
EnvironmentFile={{ node_environment_file }}
{% endif %}
ExecStart=/usr/local/bin/ros2-{{ node_name }}

[Install]
WantedBy=multi-user.target
