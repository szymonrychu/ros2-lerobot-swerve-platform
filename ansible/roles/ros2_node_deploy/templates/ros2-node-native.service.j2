[Unit]
Description=ROS2 node {{ node_name }}
{% if node_type != 'fastdds_discovery_server' %}
After=network-online.target ros2-fastdds_discovery_server.service
Wants=network-online.target ros2-fastdds_discovery_server.service
{% else %}
After=network-online.target
Wants=network-online.target
{% endif %}

[Service]
Type=simple
User={{ ansible_user }}
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
CPUQuota={{ node_cpu_quota | default('50%') }}
MemoryMax={{ node_memory_max | default('256M') }}
{% if node_type != 'fastdds_discovery_server' %}
{% for env in ros2_dds_env | default([]) %}
Environment={{ env }}
{% endfor %}
{% endif %}
{% for env in node_env | default([]) %}
Environment={{ env }}
{% endfor %}
ExecStart=/usr/local/bin/ros2-{{ node_name }}

[Install]
WantedBy=multi-user.target
