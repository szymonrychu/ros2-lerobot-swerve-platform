# {{ ansible_managed }}
[Unit]
Description=Restart ros2 units whose Fast DDS discovery thread is deadlocked (docs/runbooks/dds-discovery-deadlock.md)

[Service]
Type=oneshot
Slice=monitoring.slice
Nice={{ monitoring_agent_nice }}
# TimeoutStartSec bounds a run: 60 s (systemctl list-units) + max_restarts_per_run x (60 s systemctl restart + 2
# calibration attempts x the calibration timeout) + a 30 s margin (see the role defaults). The cap on restarts per run
# makes this a real bound. Raise monitoring_agent_dds_watchdog_start_timeout_s together with a larger timeout or cap.
TimeoutStartSec={{ monitoring_agent_dds_watchdog_start_timeout_s }}
Environment=DDS_WATCHDOG_PROC_ROOT={{ monitoring_agent_dds_watchdog_proc_root }}
Environment=DDS_WATCHDOG_CGROUP_ROOT={{ monitoring_agent_dds_watchdog_cgroup_root }}
Environment=DDS_WATCHDOG_STATE_FILE={{ monitoring_agent_dds_watchdog_state_dir }}/state.json
Environment=DDS_WATCHDOG_TEXTFILE={{ monitoring_agent_textfile_dir }}/dds_watchdog.prom
Environment=DDS_WATCHDOG_SAMPLES={{ monitoring_agent_dds_watchdog_samples }}
Environment=DDS_WATCHDOG_RX_MIN_BYTES={{ monitoring_agent_dds_watchdog_rx_min_bytes }}
Environment=DDS_WATCHDOG_MIN_RESTART_INTERVAL_S={{ monitoring_agent_dds_watchdog_min_restart_interval_s }}
Environment=DDS_WATCHDOG_MAX_RESTARTS_PER_RUN={{ monitoring_agent_dds_watchdog_max_restarts_per_run }}
Environment=DDS_WATCHDOG_DEPLOY_LOCK={{ monitoring_agent_dds_watchdog_deploy_lock }}
Environment=DDS_WATCHDOG_DEPLOY_LOCK_MAX_AGE_S={{ monitoring_agent_dds_watchdog_deploy_lock_max_age_s }}
Environment=DDS_WATCHDOG_DRY_RUN={{ monitoring_agent_dds_watchdog_dry_run | lower }}
Environment=DDS_WATCHDOG_CALIBRATION_URL={{ monitoring_agent_dds_watchdog_calibration_url }}
Environment=DDS_WATCHDOG_CALIBRATION_TIMEOUT_S={{ monitoring_agent_dds_watchdog_calibration_timeout_s }}
Environment=SYSTEMCTL={{ monitoring_agent_dds_watchdog_systemctl }}
ExecStart=/usr/bin/python3 /usr/local/lib/monitoring/dds_watchdog.py
