# {{ ansible_managed }}
# Moves {{ item.name }}.service into monitoring.slice with its own memory cap; the OOM killer picks it before robot nodes.
[Service]
Slice=monitoring.slice
Nice={{ monitoring_agent_nice }}
MemoryMax={{ item.memory_max }}
OOMScoreAdjust={{ monitoring_agent_oom_score_adjust }}
Restart=on-failure
RestartSec=10
{% if item.name == 'alloy' %}
# prometheus.exporter.cadvisor reads every cgroup under /sys/fs/cgroup and /proc of the host and loki.source.journal
# reads the system journal; run it as root so nothing is hidden by permissions (the package default is User=alloy).
User=root
Group=root
{% endif %}
