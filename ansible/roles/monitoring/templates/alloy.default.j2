# {{ ansible_managed }}
# Read by alloy.service: ExecStart=/usr/bin/alloy run $CUSTOM_ARGS --storage.path=/var/lib/alloy/data $CONFIG_FILE
CONFIG_FILE="/etc/alloy/config.alloy"

# UI and /metrics on the LAN; no usage reporting to Grafana Labs.
CUSTOM_ARGS="--server.http.listen-addr=0.0.0.0:{{ monitoring_alloy_port }} --disable-reporting"

RESTART_ON_UPGRADE=true
