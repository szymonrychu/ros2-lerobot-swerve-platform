    },
    {
      "type": "state-timeline",
      "title": "Agent busy",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "1 while the agent works on an instruction (agent_busy).",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "transparent"
                },
                "1": {
                  "text": "busy",
                  "color": "blue"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "agent_busy",
          "legendFormat": "busy"
        }
      ]
    },
    {
