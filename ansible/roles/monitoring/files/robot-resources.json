          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(container_memory_rss{id=~\"/(system|monitoring)\\\\.slice/(ros2-.+|alloy|prometheus|grafana-server)\\\\.service\"}, \"unit\", \"$1\", \"id\", \".*/(.+)\\\\.service\")",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Per-unit disk IO",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
