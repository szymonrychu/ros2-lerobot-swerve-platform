      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(rate(container_fs_reads_bytes_total{id=~\"/(system|monitoring)\\\\.slice/(ros2-.+|alloy|prometheus|grafana-server)\\\\.service\"}[$__rate_interval]), \"unit\", \"$1\", \"id\", \".*/(.+)\\\\.service\")",
          "legendFormat": "read {{unit}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "label_replace(rate(container_fs_writes_bytes_total{id=~\"/(system|monitoring)\\\\.slice/(ros2-.+|alloy|prometheus|grafana-server)\\\\.service\"}[$__rate_interval]), \"unit\", \"$1\", \"id\", \".*/(.+)\\\\.service\")",
          "legendFormat": "write {{unit}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Monitoring stack",
      "id": 17,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 70
      }
    },
    {
      "type": "timeseries",
      "title": "Monitoring stack overhead",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "CPU cores used by Alloy, Prometheus, Grafana and the throttling timer; dashed: the slice quota.",
      "gridPos": {
