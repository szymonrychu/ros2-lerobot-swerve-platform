{
  "title": "Robot health",
  "uid": "robot-health",
  "description": "Every ros2-* and monitoring unit, node endpoints, error counters per node, throttling and host pressure.",
  "tags": [
    "robot",
    "health"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Robot dashboards",
      "tags": [
        "robot"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Units",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Unit states",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Current systemd state of every ros2-* unit and the monitoring units (node_systemd_unit_state).",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "state",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "max by (name, state) (node_systemd_unit_state{name=~\"ros2-.+\\\\.service|alloy\\\\.service|prometheus\\\\.service|grafana-server\\\\.service|nginx\\\\.service\"}) == 1",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "name": "unit"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Unit restarts in window",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Automatic systemd restarts (NRestarts) of each unit in the selected time range; only units that restarted.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "restarts",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "sum by (name) (increase(node_systemd_service_restart_total{name=~\"ros2-.+\\\\.service|alloy\\\\.service|prometheus\\\\.service|grafana-server\\\\.service|nginx\\\\.service\"}[$__range])) > 0",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "unit",
              "Value": "restarts"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Nodes",
      "id": 4,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "state-timeline",
      "title": "Node up/down",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Scrape of each node's /metrics endpoint (up) and its robot_node_info; down = not running or no endpoint.",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "max by (node) (up{job=\"ros2_nodes\"})",
          "legendFormat": "{{node}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "max by (node) (robot_node_info)",
          "legendFormat": "{{node}} info"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Time since node start",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Uptime of each node process (robot_node_start_time_seconds); a short bar is a recent restart.",
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 300
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "time() - max by (node) (robot_node_start_time_seconds)",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Errors per node in window",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Error counters per node in the selected time range: servo bus, IMU errors/reinits, GPS serial errors/NTRIP reconnects, camera drops/reopens, lidar restarts, web UI ws disconnects/stale topics, agent watchdog, MCP tool errors.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(sum by (node) (increase(servo_bus_read_failures_total[$__range])), \"counter\", \"servo bus read failures\", \"\", \"\") or label_replace(sum by (node) (increase(servo_set_register_failures_total[$__range])), \"counter\", \"servo set register failures\", \"\", \"\") or label_replace(sum by (node) (increase(imu_read_errors_total[$__range])), \"counter\", \"IMU read errors\", \"\", \"\") or label_replace(sum by (node) (increase(imu_reinits_total[$__range])), \"counter\", \"IMU reinits\", \"\", \"\") or label_replace(sum by (node) (increase(gps_serial_errors_total[$__range])), \"counter\", \"GPS serial errors\", \"\", \"\") or label_replace(sum by (node) (increase(gps_ntrip_reconnects_total[$__range])), \"counter\", \"GPS NTRIP reconnects\", \"\", \"\") or label_replace(sum by (node) (increase(camera_frames_dropped_total[$__range])), \"counter\", \"camera frames dropped\", \"\", \"\") or label_replace(sum by (node) (increase(camera_reopens_total[$__range])), \"counter\", \"camera reopens\", \"\", \"\") or label_replace(sum by (node) (increase(lidar_driver_restarts_total[$__range])), \"counter\", \"lidar driver restarts\", \"\", \"\") or label_replace(sum by (node) (increase(webui_ws_disconnects_total[$__range])), \"counter\", \"web UI ws disconnects\", \"\", \"\") or label_replace(sum by (node) (increase(webui_topic_stale_total[$__range])), \"counter\", \"web UI stale topics\", \"\", \"\") or label_replace(sum by (node) (increase(agent_watchdog_fires_total[$__range])), \"counter\", \"agent watchdog fires\", \"\", \"\") or label_replace(sum by (node) (increase(mcp_tool_calls_total{outcome=\"error\"}[$__range])), \"counter\", \"MCP tool errors\", \"\", \"\")",
          "legendFormat": "{{node}}: {{counter}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "row",
      "title": "Host",
      "id": 8,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "state-timeline",
      "title": "Throttling",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Raspberry Pi throttling bits (vcgencmd get_throttled): *_now is the current state, *_occurred since boot.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no",
                  "color": "green"
                },
                "1": {
                  "text": "yes",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "rpi_throttled",
          "legendFormat": "{{bit}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "SoC and sensor temperatures (the Pi 5 soft-throttles at 80-85 C).",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "node_thermal_zone_temp",
          "legendFormat": "{{zone}} {{type}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "node_hwmon_temp_celsius",
          "legendFormat": "{{chip}} {{sensor}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk pressure",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Root filesystem usage and PSI IO pressure (share of time tasks waited on IO).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "legendFormat": "root used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "rate(node_pressure_io_waiting_seconds_total[$__rate_interval])",
          "legendFormat": "IO pressure (waiting)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory pressure",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Memory in use, PSI memory pressure and OOM kills (cgroup OOM events).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "rate(node_pressure_memory_waiting_seconds_total[$__rate_interval])",
          "legendFormat": "memory pressure (waiting)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "C",
          "expr": "sum(increase(container_oom_events_total[5m])) > 0",
          "legendFormat": "OOM events (5 min)"
        }
      ]
    }
  ]
}
