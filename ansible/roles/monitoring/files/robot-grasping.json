      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Motion steps per 15 min by kind and status.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "sum by (kind, status) (increase(mcp_motion_steps_total[15m]))",
          "legendFormat": "{{kind}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tracking error p50/p95",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Joint tracking error at the end of a motion step, quantiles per kind, 15 min window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rad"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, kind) (rate(mcp_motion_tracking_error_rad_bucket[15m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(mcp_motion_tracking_error_rad_bucket[15m])))",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Grasp tool latency p50/p95",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Duration quantiles of the grasp-related MCP tools (plan_grasp, grasp_object, release_object, move_arm_cartesian, set_gripper), 15 min window.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, tool) (rate(mcp_tool_duration_seconds_bucket{tool=~\"plan_grasp|grasp_object|release_object|move_arm_cartesian|set_gripper\"}[15m])))",
          "legendFormat": "p50 {{tool}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mcp_tool_duration_seconds_bucket{tool=~\"plan_grasp|grasp_object|release_object|move_arm_cartesian|set_gripper\"}[15m])))",
          "legendFormat": "p95 {{tool}}"
        }
      ]
    },
