          "expr": "sum by (profile) (increase(mcp_grip_profile_uses_total[15m]))",
          "legendFormat": "{{profile}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Floor guard slowdowns",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Arm moves slowed by the floor guard per 15 min, by reason.",
      "gridPos": {
        "h": 8,
        "w": 8,
