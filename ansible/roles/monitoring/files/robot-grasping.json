      ]
    },
    {
      "type": "state-timeline",
      "title": "Servo torque enabled per joint",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Torque enable state per arm joint.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "off",
                  "color": "transparent"
                },
                "1": {
                  "text": "on",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "servo_torque_enabled{joint=~\"shoulder_pan|shoulder_lift|elbow_flex|wrist_flex|wrist_roll|gripper\"}",
          "legendFormat": "{{joint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Servo bus failures",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Servo bus read and set-register failures per 5 min; 'bus down' is 1 while the bus is unreachable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
