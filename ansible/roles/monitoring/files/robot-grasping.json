          "legendFormat": "read {{joint}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "sum by (reason) (increase(servo_set_register_failures_total[5m]))",
          "legendFormat": "set register {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "C",
          "expr": "1 - servo_bus_up",
          "legendFormat": "bus down"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Servo voltage per joint",
      "id": 17,
      "datasource": {
        "type": "prometheus",
