    {
      "type": "timeseries",
      "title": "SLAM stack unit CPU",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "CPU cores used per unit (cgroup).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(sum by (id) (rate(container_cpu_usage_seconds_total{id=~\"/system\\\\.slice/ros2-(slam_toolbox|nav2_bringup|robot_localization_ekf|rf2o_laser_odometry|laser_filter|rplidar_a1)\\\\.service\"}[$__rate_interval])), \"unit\", \"$1\", \"id\", \".*/ros2-(.+)\\\\.service\")",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "SLAM stack unit memory",
      "id": 3,
      "datasource": {
        "type": "prometheus",
