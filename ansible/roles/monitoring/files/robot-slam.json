    {
      "type": "timeseries",
      "title": "Lidar driver restarts",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Driver restarts per 15 min by reason; the supervisor exits on a gap and systemd restarts it.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "sum by (reason) (increase(lidar_driver_restarts_total[15m]))",
          "legendFormat": "{{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "changes(robot_node_start_time_seconds{node=\"rplidar_a1\"}[15m])",
          "legendFormat": "process restarts"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "C",
          "expr": "increase(node_systemd_service_restart_total{name=\"ros2-rplidar_a1.service\"}[15m])",
          "legendFormat": "systemd restarts"
        }
      ]
    },
