      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Scan rate seen by the rplidar_a1 supervisor (A1 nominal about 7 Hz).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
