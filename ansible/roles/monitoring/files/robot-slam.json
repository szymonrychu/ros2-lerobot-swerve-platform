{
  "title": "Robot SLAM",
  "uid": "robot-slam",
  "description": "Mapping, localization and navigation: upstream units by cgroup, lidar, odometry, map, nav goals, IMU, GPS.",
  "tags": [
    "robot",
    "slam"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "type": "dashboards",
      "title": "Robot dashboards",
      "tags": [
        "robot"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Units (no in-process metrics for upstream nodes)",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "SLAM stack unit CPU",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "CPU cores used per unit (cgroup).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(sum by (id) (rate(container_cpu_usage_seconds_total{host=\"client\", id=~\"/system\\\\.slice/ros2-(slam_toolbox|nav2_bringup|robot_localization_ekf|rf2o_laser_odometry|laser_filter|rplidar_a1)\\\\.service\"}[$__rate_interval])), \"unit\", \"$1\", \"id\", \".*/ros2-(.+)\\\\.service\")",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "SLAM stack unit memory",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-robot"
      },
      "description": "Working set memory per unit (cgroup).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "A",
          "expr": "label_replace(container_memory_working_set_bytes{host=\"client\", id=~\"/system\\\\.slice/ros2-(slam_toolbox|nav2_bringup|robot_localization_ekf|rf2o_laser_odometry|laser_filter|rplidar_a1)\\\\.service\"}, \"unit\", \"$1\", \"id\", \".*/ros2-(.+)\\\\.service\")",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
