          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-robot"
          },
          "refId": "B",
          "expr": "rate(lidar_scans_total{host=\"client\"}[1m])",
          "legendFormat": "scans/s (1 min)"
        }
