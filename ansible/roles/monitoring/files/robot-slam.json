          "refId": "A",
          "expr": "label_replace(container_memory_working_set_bytes{id=~\"/system\\\\.slice/ros2-(slam_toolbox|nav2_bringup|robot_localization_ekf|rf2o_laser_odometry|laser_filter|rplidar_a1)\\\\.service\"}, \"unit\", \"$1\", \"id\", \".*/ros2-(.+)\\\\.service\")",
