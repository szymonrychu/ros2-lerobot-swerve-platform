# Managed by Ansible (role jetson_link). NAT for the Jetson: {{ jetson_link_subnet }} out of {{ _jetson_link_wan_interface }}.
# Re-declared then deleted so loading the file twice replaces the table instead of stacking rules.
table ip jetson_link {}
delete table ip jetson_link
table ip jetson_link {
  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "{{ jetson_link_interface }}" oifname "{{ _jetson_link_wan_interface }}" accept
    iifname "{{ _jetson_link_wan_interface }}" oifname "{{ jetson_link_interface }}" ct state established,related accept
    iifname "{{ jetson_link_interface }}" drop
    oifname "{{ jetson_link_interface }}" drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "{{ _jetson_link_wan_interface }}" ip saddr {{ jetson_link_subnet }} masquerade
  }
}
