<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>head_camera_cpp</name>
  <version>0.1.0</version>
  <description>libcamera node for the head Camera Module 3 (IMX708): 30 fps image_raw, image_raw/compressed and camera_info, plus autofocused full-resolution zoom crops on request.</description>
  <maintainer email="szymon.rychu@gmail.com">Szymon Richert</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros2_common_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>libcamera</depend>
  <depend>prometheus-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
