<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetson_bridge_cpp</name>
  <version>0.1.0</version>
  <description>Pi side of the Jetson vision coprocessor link: turns the depth wire frames of jetson/depthd into the existing ROS messages (16UC1 depth, camera_info, JPEG overview) and drops frames that are stale or from the future.</description>
  <maintainer email="szymon.rychu@gmail.com">Szymon Richert</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros2_common_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>libzmq3-dev</depend>
  <depend>libzstd-dev</depend>
  <depend>prometheus-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
