<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>head_rgbd_cpp</name>
  <version>0.1.0</version>
  <description>Adapts the head D435 aligned depth and colour to the /head_rgbd contract: a throttled RGB-D pair and a coloured point cloud.</description>
  <maintainer email="szymon.rychu@gmail.com">Szymon Richert</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ros2_common_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>image_geometry</depend>
  <depend>depth_image_proc</depend>
  <depend>yaml-cpp</depend>
  <depend>libopencv-dev</depend>
  <depend>prometheus-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
