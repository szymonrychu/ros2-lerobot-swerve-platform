<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_drive_wait_bt_cpp</name>
  <version>0.1.0</version>
  <description>Nav2 BT action node WaitForArmDriveReady (library arm_drive_wait_bt_node): holds a NavigateToPose goal until mcp_server lifted the arm to its drive pose, skipped the lift or has it disabled (/arm/drive_pose/state), at most timeout_s; never fails the goal.</description>
  <maintainer email="szymon.rychu@gmail.com">Szymon Richert</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
