<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_common_cpp</name>
  <version>0.1.0</version>
  <description>Shared C++ helpers of the robot's C++ nodes: YAML config validation (exit 78), Prometheus metrics and the depth edge mask (OpenCV). Plain libraries, no ROS client library.</description>
  <maintainer email="szymon.rychu@gmail.com">Szymon Richert</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>yaml-cpp</depend>
  <!-- prometheus-cpp has no rosdep rule upstream; scripts/cpp-node-test.Dockerfile adds one (apt prometheus-cpp-dev). -->
  <depend>prometheus-cpp</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
